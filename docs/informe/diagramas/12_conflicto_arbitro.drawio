n=left;verticalAlign=middle;spacing=0;fontSize=12.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="7.5" y="189.8" width="399.8" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="• El saludo pide cuello + buzzer: le quita el buzzer a" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="7.5" y="212.2" width="348.8" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="la polca (prio 2, interrumpible por 1) y el cuello al" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="7.5" y="230.2" width="343.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="seguimiento. La polca se cancela." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="7.5" y="248.2" width="214.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="• Al terminar el saludo, el seguimiento retoma el cuello." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="7.5" y="270.8" width="367.9" height="17.2" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>