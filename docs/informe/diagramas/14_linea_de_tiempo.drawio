<mxfile host="Electron" type="device"><diagram name="Línea de tiempo" id="d1"><mxGraphModel dx="990" dy="645" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1030" pageHeight="685" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="html=1;rounded=0;strokeColor=#2f6b4f;strokeWidth=3.0;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="15.0" as="sourcePoint"/><mxPoint x="135.0" y="630.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2c5d8a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="22.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c5" value="30/09" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="22.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Rendimiento en la Pi.&lt;/b&gt; YOLO a 480 px daba 11 Hz y saturaba la CPU → YOLO26n a 256 px (30 Hz solo) y percepción en 2 procesos." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="22.2" width="905.0" height="18.6" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2c5d8a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="76.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c8" value="07/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="76.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Visores en la Pi&lt;/b&gt; con la cámara real; se eligen las cámaras por nombre." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="76.2" width="489.3" height="18.6" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c7712b;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="130.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c11" value="09–13/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="130.2" width="68.1" height="18.6" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Banco de servos.&lt;/b&gt; Se caracterizan RDS3218, HS-7955TG, MG996R, MG90S y SG90; se descarta un RDS3218 que vibraba." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="130.2" width="826.6" height="18.6" as="geometry"/></mxCell><mxCell id="c13" value="Asignación: yaw RDS3218 · pitch HS-7955TG · roll MG996R." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="149.7" width="425.8" height="18.6" as="geometry"/></mxCell><mxCell id="c14" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c7712b;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="196.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c15" value="14/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="196.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Firmware de la ESP32-C3&lt;/b&gt; hecho y cargado: 30/30 pruebas, PING→ACK 4,4 ms. Alimentación: fuente" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="196.2" width="681.1" height="18.6" as="geometry"/></mxCell><mxCell id="c17" value="de laboratorio 6 V (servos) + powerbank (Pi). Modelos mecánicos v3 (Pi en la cabeza) y v4." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="215.7" width="635.6" height="18.6" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6b5a9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="262.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c19" value="15/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="262.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Plan del detector de camisetas&lt;/b&gt; (reglas de color y patrón) e imágenes de referencia." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="262.2" width="577.4" height="18.6" as="geometry"/></mxCell><mxCell id="c21" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6b5a9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="316.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c22" value="14–26/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="316.2" width="68.1" height="18.6" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Buzzer:&lt;/b&gt; simulador de sonidos, polca transcrita de la partitura, módulo pasivo MH-FMD." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="316.2" width="599.4" height="18.6" as="geometry"/></mxCell><mxCell id="c24" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c7712b;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="370.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c25" value="30/10" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="370.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Diseño mecánico v6 R4&lt;/b&gt; (vigente), impreso y armado." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="370.2" width="354.6" height="18.6" as="geometry"/></mxCell><mxCell id="c27" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6b4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="424.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c28" value="03/11" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="424.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Robot real completo:&lt;/b&gt; calibración montada, cámara invertida, eventos (ME_MIRA, SALUDO, SALIENDO)," style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="424.2" width="700.2" height="18.6" as="geometry"/></mxCell><mxCell id="c30" value="overlay T7, modos de personalidad, curiosidad, servicio de demo y panel del celular. Buzzer al GPIO5." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="443.7" width="713.1" height="18.6" as="geometry"/></mxCell><mxCell id="c31" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6b4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="490.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c32" value="04/11" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="490.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Camisetas en vivo&lt;/b&gt; (Olimpia 99 %, Cerro 98 %, lisas 0 % de falsos positivos). Volumen, panel siempre prendido." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="490.2" width="770.0" height="18.6" as="geometry"/></mxCell><mxCell id="c34" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6b4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="544.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c35" value="05/11" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="544.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Dos MG996R nuevos&lt;/b&gt; en pitch y roll. Mirada por objetivo y Observador por miradas (contra la vibración)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="544.2" width="721.7" height="18.6" as="geometry"/></mxCell><mxCell id="c37" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6b4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127.5" y="598.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c38" value="07/11" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15.0" y="598.2" width="44.1" height="18.6" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Documentación&lt;/b&gt; para lectura externa: README, checklist de la consigna, esta guía." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.8;fontColor=#1f2a27;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="598.2" width="566.6" height="18.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>